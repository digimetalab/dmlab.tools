# ==========================================
# DMLab Tools - Environment Configuration
# ==========================================

# 1. Groq AI API Configuration
# Dapatkan API Key di https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"
# Model yang digunakan (contoh: llama-3.3-70b-versatile atau llama-3.1-8b-instant)
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Database Configuration (Automatic Dual-Mode Detection)
# -------------------------------------------------------------
# A. Saat di Lokal (npm run dev):
#    Sistem otomatis menggunakan SQLite lokal di folder data (file:data/local.db).
#
# B. Saat di Vercel (vercel dev / deploy ke Vercel):
#    Sistem otomatis mendeteksi environment VERCEL dan beralih ke Turso Cloud.
#    Pastikan TURSO_DATABASE_URL dan TURSO_AUTH_TOKEN telah diisi di Dashboard Vercel.
# -------------------------------------------------------------
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# (Opsional) Override eksplisit untuk lokal:
# DATABASE_URL="file:data/local.db"
# DATABASE_MODE="remote" # Aktifkan baris ini jika ingin memaksa Turso saat di luar Vercel

# 3. Authentication & Security
# Kunci rahasia untuk enkripsi token JWT sesi pengguna
JWT_SECRET="your_secure_random_jwt_secret_key_min_32_characters"

# 4. Server Settings
PORT=3000
NODE_ENV="development"
