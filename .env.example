# ==========================================
# DMLab Tools - Environment Configuration
# ==========================================

# 1. Groq AI API Configuration
# Obtain your API key at https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"
# AI model to use (e.g., llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Database Configuration (Automatic Dual-Mode Detection)
# -------------------------------------------------------------
# A. In Local Development (npm run dev):
#    The system automatically uses embedded SQLite in the data folder (file:data/local.db).
#
# B. In Vercel Environment (vercel dev / Vercel preview & production deployment):
#    The system automatically detects VERCEL environment and switches to Turso Cloud DB over HTTP.
#    Ensure TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are configured in your Vercel Dashboard.
# -------------------------------------------------------------
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# (Optional) Explicit override for local development:
# DATABASE_URL="file:data/local.db"
# DATABASE_MODE="remote" # Set this to force Turso cloud connection outside Vercel

# 3. Authentication & Security
# Cryptographic secret key used to sign and verify user session JWT tokens
JWT_SECRET="your_secure_random_jwt_secret_key_min_32_characters"

# Google OAuth 2.0 (Google Identity Services)
# Obtain your Client ID at https://console.cloud.google.com/apis/credentials
# Add http://localhost:3071 (or your dev/prod port) to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# 4. Server Settings
PORT=3000
NODE_ENV="development"
